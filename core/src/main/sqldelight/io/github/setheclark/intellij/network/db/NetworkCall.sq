-- Bump NetworkHistorySchema.VERSION whenever this file changes. A mismatch drops and recreates the database.

CREATE TABLE network_call (
    seq INTEGER PRIMARY KEY AUTOINCREMENT,
    call_id TEXT NOT NULL UNIQUE,
    device_id TEXT NOT NULL,
    package_name TEXT NOT NULL,
    app_instance TEXT NOT NULL,
    start_time INTEGER NOT NULL,
    name TEXT NOT NULL,
    request_url TEXT NOT NULL,
    request_method TEXT NOT NULL,
    request_headers TEXT NOT NULL,
    request_size INTEGER,
    -- 'http', 'graphql' or 'grpc'
    request_type TEXT NOT NULL,
    graphql_persisted INTEGER,
    graphql_query TEXT,
    graphql_operation_name TEXT,
    graphql_operation_type TEXT,
    -- 0 = no response yet, 1 = success, 2 = failure
    response_kind INTEGER NOT NULL,
    response_duration_ms REAL,
    response_headers TEXT,
    response_size INTEGER,
    response_content_type TEXT,
    response_status_code INTEGER,
    response_issue TEXT
);

CREATE INDEX network_call_session ON network_call(device_id, package_name, app_instance, seq);
CREATE INDEX network_call_device ON network_call(device_id, package_name, seq);

CREATE TABLE network_body (
    call_id TEXT NOT NULL REFERENCES network_call(call_id) ON DELETE CASCADE,
    -- 0 = request, 1 = response
    kind INTEGER NOT NULL,
    data TEXT NOT NULL,
    PRIMARY KEY (call_id, kind)
);

-- Clear history marks an app session instead of deleting its rows, so retention purges them later.
-- Calls of the session that started at or before cleared_through (the device's own clock) are hidden.
CREATE TABLE network_clear (
    device_id TEXT NOT NULL,
    package_name TEXT NOT NULL,
    app_instance TEXT NOT NULL,
    cleared_through INTEGER NOT NULL,
    PRIMARY KEY (device_id, package_name, app_instance)
);

insertCall:
INSERT OR REPLACE INTO network_call(
    call_id, device_id, package_name, app_instance, start_time, name,
    request_url, request_method, request_headers, request_size, request_type,
    graphql_persisted, graphql_query, graphql_operation_name, graphql_operation_type,
    response_kind, response_duration_ms, response_headers, response_size,
    response_content_type, response_status_code, response_issue
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateResponse:
UPDATE network_call SET
    response_kind = ?,
    response_duration_ms = ?,
    response_headers = ?,
    response_size = ?,
    response_content_type = ?,
    response_status_code = ?,
    response_issue = ?
WHERE call_id = ?;

callExists:
SELECT EXISTS(SELECT 1 FROM network_call WHERE call_id = ?);

selectCall:
SELECT * FROM network_call WHERE call_id = ?;

selectCallsForSession:
SELECT * FROM network_call
WHERE device_id = ? AND package_name = ? AND app_instance = ?
    AND NOT EXISTS (
        SELECT 1 FROM network_clear
        WHERE network_clear.device_id = network_call.device_id
            AND network_clear.package_name = network_call.package_name
            AND network_clear.app_instance = network_call.app_instance
            AND network_call.start_time <= network_clear.cleared_through
    )
ORDER BY seq;

selectCurrentAppInstance:
SELECT app_instance FROM network_call
WHERE device_id = ? AND package_name = ?
ORDER BY seq DESC
LIMIT 1;

deleteCall:
DELETE FROM network_call WHERE call_id = ?;

deleteCallsForDevicePackage:
DELETE FROM network_call WHERE device_id = ? AND package_name = ?;

deleteClearsForDevicePackage:
DELETE FROM network_clear WHERE device_id = ? AND package_name = ?;

-- Hides every call the session has so far. Does nothing when the session has no calls.
clearSession:
INSERT OR REPLACE INTO network_clear(device_id, package_name, app_instance, cleared_through)
SELECT device_id, package_name, app_instance, MAX(start_time) FROM network_call
WHERE device_id = ? AND package_name = ? AND app_instance = ?
GROUP BY device_id, package_name, app_instance;

insertBody:
INSERT OR REPLACE INTO network_body(call_id, kind, data) VALUES (?, ?, ?);

selectBody:
SELECT data FROM network_body WHERE call_id = ? AND kind = ?;

-- Which bodies exist for a call, answered from the primary key without reading any body text.
selectBodyKinds:
SELECT kind FROM network_body WHERE call_id = ?;

-- Ids of the calls in one app session whose request or response body contains the text (ASCII case-insensitive).
searchBodies:
SELECT DISTINCT network_body.call_id FROM network_body
JOIN network_call ON network_call.call_id = network_body.call_id
WHERE network_call.device_id = ? AND network_call.package_name = ? AND network_call.app_instance = ?
    AND NOT EXISTS (
        SELECT 1 FROM network_clear
        WHERE network_clear.device_id = network_call.device_id
            AND network_clear.package_name = network_call.package_name
            AND network_clear.app_instance = network_call.app_instance
            AND network_call.start_time <= network_clear.cleared_through
    )
    AND instr(lower(network_body.data), lower(?)) > 0;

deleteBody:
DELETE FROM network_body WHERE call_id = ? AND kind = ?;
